        <!-- CALENDÁRIO -->

        <section class="calendario" id="calendario">
            <div class="container-principal">

                <section class="calendario" id="calendario">
                    <div class="interface">
                        <h1 class="titulo-section">Calendário de<span> Eventos</span></h1>

                        <div class="calendar-container">
                            <div class="calendar">
                                <div class="calendar-header">
                                    <button id="prev">&#10094;</button>
                                    <h2 id="month-year"></h2>
                                    <button id="next">&#10095;</button>
                                </div>
                                <div class="calendar-body">
                                    <div class="week-days">
                                        <div>Dom</div>
                                        <div>Seg</div>
                                        <div>Ter</div>
                                        <div>Qua</div>
                                        <div>Qui</div>
                                        <div>Sex</div>
                                        <div>Sáb</div>
                                    </div>
                                    <div class="days" id="days">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <div id="eventos-bloco" class="eventos-painel">
                    <div class="interface">
                        <button id="fechar-eventos-btn" class="fechar-btn">X</button>
                        <h2 id="eventos-titulo">Eventos</h2>

                        <div class="dia-selecionado-info">
                            <h3>Dia Selecionado: <strong id="dia-selecionado-texto">Nenhum</strong></h3>
                        </div>

                        <div class="criar-evento-form">
                            <textarea id="evento-texto" placeholder="Descreva o evento..."></textarea>
                            <button id="adicionar-evento-btn" disabled>Adicionar Evento</button>
                        </div>

                        <hr>

                        <h4>Eventos do Dia</h4>
                        <ul id="lista-eventos">
                            <li class="evento-placeholder">Selecione um dia para começar.</li>
                        </ul>
                    </div>
                </div>
            </div>

        </section>


        <!-- SECTION CONTATO-->

        <section class="contato" id="contato">

            <div class="interface">

                <div class="txt-contato">
                    <h1 class="titulo-section">Entre em<span> contato</span></h1>
                    <h2 class="sub-titulo">Formulário de Contato</h2>
                    <p><i class="bi bi-envelope-at"></i> contato@gmail.com</p>
                    <p><i class="bi bi-whatsapp"></i> (00) 0 0000-0000</p>

                </div>

                <form action="#">
                    <input type="text" name="#" id="nome" placeholder="Seu nome completo">
                    <input type="email" name="#" id="email" placeholder="Seu e-mail">
                    <div class="tel">
                        <input type="tel" name="#" id="telefone" placeholder="Seu Whatsapp">
                    </div>
                    <textarea name="#" id="mensagem" placeholder="Descreva um pouco sobre o asssunto"></textarea>

                    <div class="btn-enviar">
                        <input type="submit" value="Enviar">
                    </div>

                </form>

            </div>


        </section>



    </main>

    <footer>
        <div class="interface">

            <div class="logo-footer">
                <img src="imagens/leticia_logo (2).png" alt="logo-footer">
                <p>Todos os direitos reservados</p>
            </div>

            <div class="btn-redes">
                <a href="#"><button><i class="bi bi-instagram"></i></button></a>
                <a href="#"><button><i class="bi bi-linkedin"></i></button></a>
                <a href="#"><button><i class="bi bi-whatsapp"></i></button></a>
            </div>

        </div>
    </footer>

    <script src="java.js"></script>
    <script src="js/menu-mobile.js"></script>


</body>

</html>
