    <title>Projeto</title>
</head>

<body>


    <header>

        <div class="interface">

            <section class="logotipo-cabecalho">
                <a href="#hero">
                    <img src="C:\Programas\PORTFOLIO\imagens\leticia_logo (2).png" alt="Logotipo do site">
                </a>
            </section>


            <nav class="menu-desktop">
                <ul>
                    <li><a href="#hero">Inicio</a></li>
                    <li><a href="#busca">Reels</a></li> <!--# vazio-->
                    <li><a href="#topicos">Tópicos</a></li>
                    <li><a href="#sobre-mim">Sobre mim</a></li>
                    <li><a href="#calendario">Eventos</a></li>
                    <li><a href="#contato"><button>Contato</button></a></li>
                </ul>
            </nav>

            <div class="btn-menu-mobile" id="btn-menu-mobile">
                <i class="bi bi-list"></i>
            </div>

            <nav class="menu-mobile" id="menu-mobile">
                <i class="bi bi-x-lg"></i>
                <ul>
                    <li><a href="#hero">Inicio</a></li>
                    <li><a href="#busca">Reels</a></li> <!--# vazio-->
                    <li><a href="#topicos">Tópicos</a></li>
                    <li><a href="#sobre-mim">Sobre mim</a></li>
                    <li><a href="#calendario">Eventos</a></li>
                    <li><a href="#contato">Contato</a></li>
                </ul>
            </nav>

        </div>



    </header>

    <main>

        <!-- SECTION HERO -->

        <section class="hero" id="hero">
            <div class="interface">

                <div class="img-hero">
                    <img src="C:\Programas\PORTFOLIO\imagens\leticiaMais.png" alt="foto do profissional">
                </div>

                <div class="txt-hero">
                    <h1>PROJETO<span>DRA. LETÍCIA</span></h1>
                    <p>Lorem ipsum dolor sit amet consectetur adipisicing elit. Sit cupiditate dicta nihil quod libero
                        quisquam harum nisi laudantium amet exercitationem dolorem, similique magnam voluptas dolores
                        vero fugiat dolore totam nesciunt?</p>
                </div>


            </div>
        </section>

        <!-- SECTION BUSCAR -->

        <section class="busca" id="busca">
            <div class="interface">

                <div class="text-busca">
                    <h1 class="titulo-section">Reels<span> em Destaque</span></h1>

                </div>


                <div class="container">

                    <!-- Barra de busca -->
                    <div class="search-box">
                        <input id="searchInput" type="text"
                            placeholder="Buscar por termos como pega, dor, mastite..." />
                    </div>



                    <!-- Filtros -->
                    <div class="filters">
                        <button class="filter-btn active" data-filter="all">Todos</button>
                        <button class="filter-btn" data-filter="tecnicas">Amamentação</button>
                        <button class="filter-btn" data-filter="dificuldades">Dificuldades</button>
                        <button class="filter-btn" data-filter="mitos">Mitos e Verdades</button>
                        <button class="filter-btn" data-filter="saude">Saúde da Mãe</button>
                         <button class="filter-btn" data-filter="alimentacao">Alimentação</button>
                    </div>

                    <!-- Grid de Reels -->
                    <div class="reels-grid" id="reelsGrid">

                        <!-- CARD EXEMPLO 1 -->
                        <!-- <div class="reel-card" data-category="tecnicas" data-title="Pega correta da amamentação">
