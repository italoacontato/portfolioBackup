/* ESTILOS UNIVERSAIS */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: "Plus Jakarta Sans", sans-serif;
}

/* VARIÁVEIS COR */

:root {
    --corAmarela: #FBCA2D;
    --corAzul: #17043B;
    --corBranca: #ffffff;
    --corRoxoEscuro: #562390;
    --corRoxoClaro: #9e6de7;
    --corCinza: #786f6f;
    --corRoxoPastel: #6924b8;
    --corRoxoEscuro1: #170829;
    --corRoxaEscuro2: #270b47;
    --corRoxaBebe: #c09cea;
    --corRoxaSuperClaro: #e3d1ff;
    --corRoxoTom2: #521c90;
}

html {
    scroll-behavior: smooth;
}

body {
    background-color: var(--corRoxoPastel);
    overflow-x: hidden;
    /* 🔹 Impede rolagem horizontal */
}

/* ESTILOS UNIVERSAIS */

button {
    background-color: transparent;
    border: 2px solid var(--corBranca);
    border-radius: 8px;
    color: var(--corBranca);
    cursor: pointer;
}

button:hover {
    background-color: var(--corRoxoClaro);
    color: var(--corAzul);
    font-size: 1.1rem;
    transition: 0.5s;

}

h1.titulo-section {
    font-size: 4rem;
    color: var(--corBranca);
    text-align: justify;
    padding: 10px 20px;

}

h1.titulo-section span {
    color: var(--corRoxaBebe);
}

.interface {
    max-width: 1380px;
    padding: 0 4%;
    margin: 0 auto;
}

/* ESTILO DO CABEÇALHO */

header {
    background-color: transparent;
    padding: 10px 0;
    position: fixed;
    width: 100%;
    background-image: linear-gradient(to left, var(--corRoxoEscuro) 70%, var(--corRoxoEscuro) 10%);
    z-index: 9999999;
}

header>.interface {
    display: flex;
    align-items: center;
    justify-content: space-between;
}

header .logotipo-cabecalho img {
    max-width: 180px;

}

header nav.menu-desktop ul {
    display: flex;
    align-items: center;
    list-style: none;
    gap: 56px;
}

header nav.menu-desktop a {
    color: var(--corBranca);
    text-decoration: none;
    font-size: 1.1rem;
    transition: 0.5s;
}

header nav.menu-desktop a:hover {
    color: var(--corRoxoClaro);
}

header nav.menu-desktop button {
    width: 144px;
    height: 48px;
}

/* ESTILO DO MENU MOBILE */


.btn-menu-mobile,
.menu-mobile {
    display: none;
}

.btn-menu-mobile i {
    font-size: 2.7rem;
    color: var(--corRoxaBebe);
}

.menu-mobile {
    position: fixed;
    top: 0;
    left: 100%;
    width: 100%;
    height: 100vh;
    background-color: var(--corRoxaEscuro2);
    text-align: center;
    padding: 32px 0;
    pointer-events: none;
    transition: .5s;
}

.menu-mobile ul {
    list-style: none;
    padding: 64px 0;
}

.menu-mobile ul li a {
    color: var(--corRoxaSuperClaro);
    font-size: 1.4rem;
    text-decoration: none;
    padding: 24px;
    display: block;
    transform: .6s;
}

.menu-mobile ul li a:hover {
    background-color: var(--corRoxoEscuro);
    color: var(--corRoxoEscuro1);

}

.menu-mobile .bi-x-lg {
    font-size: 2rem;
    color: var(--corRoxaSuperClaro);
    padding: 24px;
}

.menu-mobile.abrir-menu {
    left: 0;
    pointer-events: initial;
}


/* ESTILO DA HERO */

section.hero {
    background-image: linear-gradient(to left, var(--corRoxoEscuro) 70%, var(--corRoxoEscuro) 10%);
    padding-top: 0px;
    padding: 50px 0;
}


.hero>.interface {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 90px;
    padding: 9 10px;
    height: 700px;

}

.hero .img-hero {
    line-height: 0;

}


.hero .txt-hero {
    padding-top: 80px;
}

.hero .txt-hero h1 {
    font-size: 3rem;
    color: var(--corBranca);
    font-weight: 300;
    word-spacing: 6px;


}

.hero .txt-hero h1 span {
    color: var(--corRoxaBebe);
    display: block;
    font-weight: 800;
    font-size: 4rem;

}

.hero .txt-hero p {
    color: var(--corBranca);
    line-height: 1.6;
    font-size: 1.2rem;
    margin: 24px 0;
    word-spacing: 1.6px;
    text-align: justify;

}

.hero .txt-hero button {
    width: 200px;
    height: 48px;
}


/* ESTILO DOS TÓPICOS IMPORTANTES */

section.topicos {
    padding: -60px 0;
    background-color: #3B1467;
    height: 580px;
}

#topicos {
    scroll-margin-top: 150px;

}

.topicos .titulo-section {
    color: #ffffff;
    text-align: justify;
    padding: 10px 20px;
    display: inline-block;
    margin-top: -50px;
    margin-bottom: 40px;
    background-color: var(--corRoxoTom2);
    border-radius: 10px;


}

.topicos .titulo-section span {
    color: var(--corRoxaBebe);
}

/* ESTILO DO GRID */

.grid-container {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-gap: 20px;
    padding: 20px;
}

.grid-item {
    background-color: #562390;
    color: white;
    text-align: center;
    padding: 40px 0;
    font-size: 18px;
    cursor: pointer;
    border-radius: 8px;
    transition: background-color 0.3s;
    transition: all 0.3s ease;
}

.grid-item:hover {
    background-color: #7b5da7;
    transform: scale(1.05);
    /* aumenta um pouco o tamanho */
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
    /* adiciona sombra */
}


/* ESTILO DO MODAL */

.modal {
    display: none;
    position: fixed;
    z-index: 999999999;
    inset: 0;
    /* substitui top/left/right/bottom */
    background-color: rgba(0, 0, 0, 0.5);

    /*permite que o modal role junto com o conteúdo */
    overflow-y: auto;
    overflow: auto;
    background-color: #9e6de7c8;
}

/*Conteúdo do Modal*/

.modal-content {
    background-color: var(--corRoxoEscuro);
    margin: 0 auto;
    padding: 20px;
    border-radius: 12px;
    width: 100%;
    max-width: 500px;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
    position: relative;
    display: flex;
    flex-direction: column;
    top: 60px;
    max-height: calc(100vh - 100px);
}

.close {
    background-color: transparent;
    border: 2px solid var(--corBranca);
    border-radius: 8px;
    color: var(--corBranca);
    cursor: pointer;
    height: 30px;
    width: 30px;
    position: absolute;
    top: -10px;
    right: -10px;
    text-align: center;
    background-color: var(--corRoxoEscuro);

    /* Suavidade */
    transition: all 0.3s ease;
    z-index: 10;
}

.close:hover {
    background-color: var(--corRoxoClaro);
    color: var(--corAzul);
    font-size: 1.1rem;
    transition: 0.5s;
}

/* ===== Corpo do conteúdo ===== */
.modal-img {
    width: 100%;
    border-radius: 10px;
    margin-bottom: 15px;
}

.modal-title {
    margin: 10px 0;
    font-size: 1.5em;
    color: var(--corRoxaSuperClaro);
}

.modal-body {
    overflow-y: auto;
    /* 🔹 Rola internamente se o texto for grande */
    flex-grow: 1;
    /* 🔹 Ocupa todo o espaço entre header e footer */
    margin-bottom: 15px;
    padding-right: 5px;
}

.modal-desc {
    color: var(--corBranca);
    text-align: justify;
    line-height: 1.6;
    text-indent: 20px;
    padding: 0 10px;
    margin-bottom: 1em;

}

.modal-desc>p {
    text-indent: 30px;
    text-align: justify;
    line-height: 1.6;
}

/* ===== Rodapé fixo ===== */
.modal-footer {
    margin-top: auto;
    padding-top: 10px;
    border-top: 1px solid var(--corRoxaBebe);
}

/* ===== Botão/Link ===== */
.modal-link {
    display: inline-block;
    text-decoration: none;
    background: var(--corRoxoEscuro);
    color: white;
    padding: 10px 20px;
    border-radius: 8px;
    font-weight: bold;
    transition: background 0.3s;
    word-spacing: 5px;
    border: 2px solid var(--corBranca);
    border-radius: 8px;
    color: var(--corBranca);
}

.modal-link:hover {
    background: var(--corRoxaEscuro2);
}

/* ===== Responsividade para Chrome, Edge, Safari ===== */

.modal-body::-webkit-scrollbar {
    width: 10px;
    /* largura da barra */
}

.modal-body::-webkit-scrollbar-track {
    background: var(--corRoxaBebe);
    /* cor do fundo da barra */
    border-radius: 8px;
}

.modal-body::-webkit-scrollbar-thumb {
    background: var(--corRoxaEscuro2);
    /* cor do "dedo" da barra */
    border-radius: 8px;
    border: none;
    /* cria efeito de padding interno */
}

.modal-body::-webkit-scrollbar-thumb:hover {
    background: #555;
    /* cor ao passar o mouse */
}



.topicos .btn-contato {
    text-align: center;
}

.topicos .btn-contato button {
    width: 200px;
    height: 48px;

}

.topicos .btn-mostrar-modais {
    text-align: center;
    margin-top: 32px;

}

.topicos .btn-mostrar-modais button {
    width: 180px;
    height: 40px;
}

/* Esconde os itens extras */
.oculto {
    display: none;
}

/* Quando tiver a classe 'mostrar' */
.mostrar .oculto {
    display: block;
}

/* ESTILO DA SEÇÃO SOBRE MIM */

section.sobre-mim {
    padding: 10px 0;
    background-color: var(--corRoxoEscuro1);

}

#sobre-mim {
    scroll-margin-top: 150px;
}



.sobre-mim>.interface {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 96px;
}

.sobre-mim {
    position: relative;
    /* Importante para o título usar como referência */
}

.sobre-mim .titulo-section {
    position: relative;
    /* ou simplesmente remova essa linha */
    top: -176px;
    left: 0;
    display: inline-block;
    margin-bottom: 12px;
    /* controla o espaço com o conteúdo */
    background-color: var(--corRoxoTom2);
    padding: 5px 15px;
    border-radius: 10px;


}

.sobre-mim .txt-sobre p {
    position: relative;
    color: var(--corBranca);
    text-align: justify;
    line-height: 1.6;
    margin: 24px 0;
    top: -126px;


    /* garante que o parágrafo não empurre pra baixo */
    margin-bottom: -10px;
    /* espaço entre os parágrafos */
}


.sobre-mim .btn-redes button,
footer .btn-redes button {
    width: 56px;
    height: 56px;
    font-size: 24px;
    margin-right: 8px;

}

